# Copie para .env e ajuste — o Makefile carrega este arquivo sozinho (make run,
# make migrate-up etc. já rodam com essas variáveis no ambiente).
DATABASE_URL=postgres://studycentral:studycentral@localhost:5435/studycentral?sslmode=disable
PORT=8080
APP_ENV=development
# Origem(ns) do PWA em Next.js — separadas por vírgula se precisar de mais de
# uma (ex.: localhost e 127.0.0.1 são origens diferentes pro navegador mesmo
# sendo o mesmo servidor).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Assina os access tokens (JWT). Mínimo 32 caracteres — o servidor recusa
# subir com um valor mais curto. Gere um de verdade com:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-bytes

# Protege as rotas de bootstrap/emergência POST /api/admin/* (promover a
# premium, conceder o primeiro papel de admin — dali em diante, o painel
# /admin no próprio app cuida disso, sem precisar deste segredo de novo).
# Mesma regra de tamanho do JWT_SECRET.
ADMIN_SECRET=troque-por-outro-valor-aleatorio-de-pelo-menos-32-bytes
